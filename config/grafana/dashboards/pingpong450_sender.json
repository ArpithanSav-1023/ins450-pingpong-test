    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "cbs_port_tx_util_percent{port=\"$port\"}",
     "legendFormat": "out",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "unit": "percent",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "max": 110,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "#f2a900",
        "value": 80
       },
       {
        "color": "#e03131",
        "value": 90
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "in"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
