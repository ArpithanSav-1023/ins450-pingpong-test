 "tags": [
  "450",
  "cbs350",
  "sender"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "timezone": "browser",
 "graphTooltip": 1,
 "annotations": {
  "list": [
   {
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "enable": true,
    "name": "This side running",
    "iconColor": "rgba(130,130,130,0.35)",
    "expr": "pp_side_active{role=\"A\"} == 1",
    "step": "5s",
    "titleFormat": "Running",
    "useValueForTime": false
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 13,
    "h": 4
   },
   "options": {
    "mode": "markdown",
    "content": "## SENDER side  \nThis is the **PC that runs `scripts/sender.sh`** (role A). Its switch port is detected automatically (shown at the top: gi9 = port GE9, gi1 = port GE1). It sends the 450 sample mix on every multicast group plus the ONF dump, and counts what **comes back** (the echo).  \nEverything here is taken from the sender's **own** counters and its **own** switch port. *Missing* = messages that came back with a gap in the sequence numbers."
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "This side",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 13,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "pp_side_active{role=\"A\"}",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "idle",
         "color": "#8e949e"
        },
        "1": {
         "text": "RUNNING",
         "color": "#37b24d"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#8e949e",
        "value": null
       },
       {
        "color": "#37b24d",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
