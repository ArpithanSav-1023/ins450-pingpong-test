    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "cbs_port_rx_bps{port=\"$port\"} / 8e6",
     "legendFormat": "in (MB/s)",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "cbs_port_tx_bps{port=\"$port\"} / 8e6",
     "legendFormat": "out (MB/s)",
     "refId": "D"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "unit": "Mbits",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "in.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "out.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d95926"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*MB/s.*"
      },
      "properties": [
       {
        "id": "custom.hideFrom",
        "value": {
         "viz": true,
         "legend": false,
         "tooltip": false
        }
       },
       {
        "id": "unit",
        "value": "suffix: MB/s"
       },
       {
        "id": "decimals",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*Mbit/s.*"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 1
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
